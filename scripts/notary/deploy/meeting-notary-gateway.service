[Unit]
Description=meeting-notary шлюз команд портала → Ватсон (Ф9, R7.1/R7.2/R12.5/R12.6)
Documentation=https://github.com/rybalkaie/vexa
Documentation=file:///srv/meeting-notary/vexa/scripts/notary/docs/gateway-contract.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/srv/meeting-notary/vexa
Environment=PYTHONPATH=scripts
Environment=HOME=/home/dev

# ── Пути состояния ─────────────────────────────────────────────────────────
# Заданы ЯВНО, а не через `EnvironmentFile=/srv/meeting-notary/.env.notary`.
# Причина: .env.notary несёт годовой CLAUDE_CODE_OAUTH_TOKEN и токен Telegram-бота,
# а шлюз — единственная служба Ватсона, до которой достаёт интернет (через Caddy).
# Тащить в неё секреты, которыми она не пользуется, незачем.
# 🔴 Шлюз НЕ аутентифицируется к Claude вовсе: он транспорт. `claude setup-token`
# и `/login` на этой машине запрещены — один аккаунт в двух домашних папках
# выбивает сам себя за 1–3 дня и молча убивает все службы (инциденты 26.06, 17.07).
# ⚠️ Значения продублированы из .env.notary. Поменял их там — поменяй и здесь,
# иначе шлюз будет отдавать протоколы из вчерашней папки и молчать об этом.
# 🔴 ЗДЕСЬ ОБЯЗАН БЫТЬ КАЖДЫЙ ПУТЬ/ФЛАГ, КОТОРЫЙ ЧИТАЕТ КОД РУЧЕК ШЛЮЗА. Не
# объявил — процесс берёт дефолт из кода, а дефолты писались под листенер
# (`/opt/...`, куда `dev` писать не может). Ровно так в июне потерялись ВСЕ
# правки: листенер падал с PermissionError на дефолте `/opt/meeting-notary/
# _feedback_edits` (инцидент 2026-06-08). Сторож `test_gateway_unit_declares_env`
# сверяет этот список с реальными `os.environ.get` в цепочке ручек.
Environment=MEETING_NOTARY_REGISTRY_DIR=/srv/meeting-notary/registry
Environment=MEETING_NOTARY_PROTOCOLS_DIR=/home/dev/meeting-notary/_tmp/protocols
Environment=MEETING_NOTARY_ARCHIVE_DIR=/srv/meeting-notary/protocols

# ── Ф10d: правка протокола С ПОРТАЛА (POST /protocol/edit) ─────────────────
# Ручка кладёт правку в ТО ЖЕ окно, что реплай в чате, — значит ей нужны те же
# каталоги, что листенеру, а не «свои». Разъедутся — правка с экрана и правка
# реплаем попадут в РАЗНЫЕ окна, и встреча выпустит две версии, каждую без
# правок другой стороны.
Environment=MEETING_NOTARY_FEEDBACK_DIR=/home/dev/meeting-notary/_tmp/_feedback_edits
Environment=TELEMOST_PROTOCOL_DIR=/home/dev/meeting-notary/_tmp/protocols
Environment=MEETING_NOTARY_DELIVERED_ROOTS=/home/dev/meeting-notary/_tmp/transcripts:/home/dev/meeting-notary/_tmp/protocols:/srv/meeting-notary/protocols
# Без этого флага `_portal_author_is_organizer` всегда False: наряд не читается,
# организатор не опознаётся НИ У ОДНОЙ правки с портала, и правило цитирования
# отбивает даже автора встречи.
Environment=ENABLE_PORTAL_ORDERS=1
Environment=ENABLE_FEEDBACK_EDITS=1
Environment=ENABLE_QUOTE_POLICY=1
# Окна сбора правок — те же значения, что у листенера (20 мин от последней,
# потолок 2 ч от первой). Разъедутся — человек увидит на портале одно время
# выхода новой версии, а получит другое.
Environment=FEEDBACK_WINDOW_MIN=20
Environment=FEEDBACK_MAX_WINDOW_MIN=120
Environment=FEEDBACK_MAX_EDITS_PER_WINDOW=30
# Файловый журнал шлюза. Дефолт в коде — мак-путь `~/Library/Logs/...`, на VPS
# это молча создаёт мусорный каталог в /home/dev и прячет журнал не там, где его
# ищут (`journalctl` при этом работает — потому и не замечали).
Environment=MEETING_NOTARY_LOG_DIR=/home/dev/meeting-notary/logs
# Потолок одновременных записей — ОБЩИЙ с runner'ом. Разъедется — портал
# пообещает слот, которого нет (ровно то, что Ф10b чинила «честным лимитом»).
# Меняешь тут — меняй и в юните runner'а/в .env.notary.
Environment=MEETING_NOTARY_MAX_CONCURRENT_BOTS=2

# ── Секрет ─────────────────────────────────────────────────────────────────
# Только MEETING_NOTARY_GATEWAY_TOKEN (≥32 знака). Файл создаётся на VPS руками,
# права 600 dev:dev, в репозиторий не попадает НИКОГДА. Пока файла нет — шлюз
# поднимется и будет отвечать 503 всем (fail-closed), а не «пускать всех».
EnvironmentFile=-/srv/meeting-notary/.env.gateway

ExecStart=/home/dev/meeting-notary/venv/bin/python /srv/meeting-notary/vexa/scripts/notary/gateway.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Nice=10

# ── Потолки ────────────────────────────────────────────────────────────────
# Шлюз — 15-й юнит на машине с 2 vCPU, где transcription-service круглосуточно
# держит ~1,9 ГБ. Под давлением памяти ядро убивает «самого жирного», поэтому
# потолок здесь обязателен: утечка в шлюзе не имеет права стоить записи встречи.
MemoryHigh=128M
MemoryMax=192M
CPUQuota=40%
TasksMax=64

# ── Ограничение прав ───────────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Реестр нарядов, окно правок и рабочая папка протоколов — то, что шлюз пишет.
# 🔴 `_feedback_edits` обязан быть ЗДЕСЬ и быть writable: ручка правок пишет
# состояние окна (`feedback_state.write_state`) и берёт flock на `.<fid>.lock`.
# Нет пути в списке → ProtectSystem=full отдаёт EROFS, и каждая правка с портала
# теряется без внятной ошибки — тот же класс отказа, что инцидент 2026-06-08.
ReadWritePaths=/srv/meeting-notary/registry
ReadWritePaths=/home/dev/meeting-notary/_tmp/_feedback_edits
ReadWritePaths=/home/dev/meeting-notary/logs
# Протоколы шлюз только ЧИТАЕТ (отдаёт по запросу портала, ищет встречу правки).
ReadOnlyPaths=/home/dev/meeting-notary/_tmp/protocols
ReadOnlyPaths=/home/dev/meeting-notary/_tmp/transcripts
ReadOnlyPaths=/srv/meeting-notary/protocols

[Install]
WantedBy=multi-user.target

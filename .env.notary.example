# Секреты для надстройки meeting-notary поверх Vexa
# Скопируй этот файл в .env.notary рядом и заполни реальные значения.
# .env.notary в .gitignore — НЕ коммитить.
#
# Назначение каждой переменной см. в плане:
#   ~/Projects/me/plans/2026-05-26-bot-notarius-telemost.md

# Refresh-token Google OAuth для Calendar API (бот ilya.rybalka@anzhee.ru).
# Используется планировщиком встреч (Ф5) для опроса календаря.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Bot API token Telegram-бота, через который шлются ошибки и подтверждения.
# Используется обёрткой tg-send (Ф5, Ф6) и адаптером Telemost для push о waiting room (Ф2).
TELEGRAM_BOT_TOKEN=

# chat_id Ильи в Telegram. Используется адаптером Telemost для push о waiting room.
# Узнать: написать боту /start, потом GET https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# URL CPU transcription-service (faster-whisper medium) на VPS.
# Обычно резолвится через docker bridge gateway IP.
TRANSCRIPTION_SERVICE_URL=http://172.17.0.1:8083/v1/audio/transcriptions

# Опционально. Ключ Claude API для LLM-маппинга имён спикеров (Ф3).
# Если пусто — маппинг работает только regex+морфология, без LLM-добивки.
ANTHROPIC_API_KEY=

# ---- Ф3 meeting-notary-llm: interactive clarification ----
# Токен ОТДЕЛЬНОГО Telegram-бота для clarify-flow (получать у @BotFather).
# Почему отдельный, а не TELEGRAM_BOT_TOKEN: основной бот используется
# claude-telegram daemon'ом, он монопольно владеет getUpdates для своего токена;
# Telegram отдаёт updates только одному getUpdates-консюмеру.
# Если оставить пустым — clarify-уведомления НЕ отправляются (финализация
# идёт «как есть», unresolved cluster'ы остаются как «Спикер N»).
CLARIFY_BOT_TOKEN=

# Гейт включения clarify-flow в finalize-meeting.py. Дефолт ON
# (любое значение кроме `0`/`false`/`no` = on; пусто = on).
# Выключить можно когда исполнитель сам спит / не хочет получать уведомления.
ENABLE_LLM_CLARIFY=1

# Порог уверенности LLM-маппинга (Ф2). Cluster'ы с confidence < этого
# идут на clarify (вместе с полностью unresolved). Дефолт 0.7.
CLARIFY_THRESHOLD=0.7

# Окно ожидания ответа Ильи в worker'е (секунды). После — `timed_out`.
# Поздний ответ обновляет файл на диске, в группу повторно не отправляет.
# Дефолт 420 (7 минут) — компромисс «быстрая реакция / Илья мог быть на встрече».
CLARIFY_TIMEOUT=420

# Long-poll таймаут одного getUpdates у worker'а. Telegram рекомендует ≤ 50 сек.
# Менять обычно не нужно.
CLARIFY_LONG_POLL_TIMEOUT=25

# Корень `_pending_clarification/`. По дефолту:
#   - на VPS (если есть /opt/meeting-notary): `/opt/meeting-notary/_pending_clarification`
#   - на маке: `~/Projects/meeting-notary/_pending_clarification`
# MEETING_NOTARY_PENDING_DIR=

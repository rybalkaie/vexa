# Секреты для надстройки meeting-notary поверх Vexa
# Скопируй этот файл в .env.notary рядом и заполни реальные значения.
# .env.notary в .gitignore — НЕ коммитить.
#
# Назначение каждой переменной см. в плане:
#   ~/Projects/me/plans/2026-05-26-bot-notarius-telemost.md

# Refresh-token Google OAuth для Calendar API (бот ilya.rybalka@anzhee.ru).
# Используется планировщиком встреч (Ф5) для опроса календаря.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Bot API token Telegram-бота, через который шлются ошибки и подтверждения.
# Используется обёрткой tg-send (Ф5, Ф6) и адаптером Telemost для push о waiting room (Ф2).
TELEGRAM_BOT_TOKEN=

# chat_id Ильи в Telegram. Используется адаптером Telemost для push о waiting room.
# Узнать: написать боту /start, потом GET https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# URL CPU transcription-service (faster-whisper medium) на VPS.
# Обычно резолвится через docker bridge gateway IP.
# Нужен ТОЛЬКО при ENABLE_LIVE_DRAFT=1 (live-whisper). При дефолтном =0 не используется.
TRANSCRIPTION_SERVICE_URL=http://172.17.0.1:8083/v1/audio/transcriptions

# Ф3 (2026-05-29): включить live-whisper draft во время встречи.
# Дефолт 0 — выключено. На CPU-VPS live-whisper тонет (каждый 3s-чанк = POST в
# faster-whisper-medium на CPU), заваливает логи и грузит transcription-service,
# при этом бесполезен — финальный протокол собирается из полного WAV через
# Speechmatics. 1 — включить, только если есть GPU. Полный WAV пишется всегда,
# независимо от флага.
ENABLE_LIVE_DRAFT=0

# Опционально. Ключ Claude API для LLM-маппинга имён спикеров (Ф3).
# Если пусто — маппинг работает только regex+морфология, без LLM-добивки.
ANTHROPIC_API_KEY=

# ---- Ф3 meeting-notary-llm: interactive clarification ----
# Clarify переиспользует существующий `@ilya_protocol_meeting_bot` (тот же бот,
# через который шлётся вечерний блок 📅). Токен — `TELEGRAM_NOTARIUS_BOT_TOKEN`
# (объявлен ниже, нужен для meetings_listener; clarify читает оттуда же).
# Listener daemon владеет getUpdates на этом токене и роутит callback'и /
# текст в `lib.clarify_worker`. Отдельного `CLARIFY_BOT_TOKEN` больше нет.

# Токен @ilya_protocol_meeting_bot — основной канал нотариуса.
# Используется meetings_listener + clarify (Ф3) + delivery в группы (Ф6).
TELEGRAM_NOTARIUS_BOT_TOKEN=

# chat_id Ильи в личке notarius-бота (число). Если не задан — fallback
# на TELEGRAM_CHAT_ID. Один из двух обязателен для clarify.
TELEGRAM_NOTARIUS_CHAT_ID=

# Гейт включения clarify-flow в finalize-meeting.py. Дефолт ON
# (любое значение кроме `0`/`false`/`no` = on; пусто = on).
# Выключить можно когда исполнитель сам спит / не хочет получать уведомления.
ENABLE_LLM_CLARIFY=1

# Порог уверенности LLM-маппинга (Ф2). Cluster'ы с confidence < этого
# идут на clarify (вместе с полностью unresolved). Дефолт 0.7.
CLARIFY_THRESHOLD=0.7

# Окно ожидания ответа Ильи в worker'е (секунды). После — `timed_out`.
# Поздний ответ обновляет файл на диске, в группу повторно не отправляет.
# Дефолт 420 (7 минут) — компромисс «быстрая реакция / Илья мог быть на встрече».
CLARIFY_TIMEOUT=420

# Long-poll таймаут одного getUpdates у worker'а. Telegram рекомендует ≤ 50 сек.
# Менять обычно не нужно.
CLARIFY_LONG_POLL_TIMEOUT=25

# Корень `_pending_clarification/`. По дефолту:
#   - на VPS (если есть /opt/meeting-notary): `/opt/meeting-notary/_pending_clarification`
#   - на маке: `~/Projects/meeting-notary/_pending_clarification`
# MEETING_NOTARY_PENDING_DIR=

# ---- Ф4 meeting-notary-llm: генерация протокола ----

# Гейт автогенерации `<date>-protokol.md` в finalize-meeting.py.
# Дефолт ON (любое кроме `0`/`false`/`no` = on). Выключи если генерация
# падает и хочется временно завершать финализацию без протокола (он потом
# догенерируется через `tools/regenerate-protocol.py <series> <date>`
# или Telegram-команду «протокол <series> <date>»).
ENABLE_PROTOCOL_GENERATION=1

# Каталог с методом-стандартом `kak-delat-protokol-vstrechi.md`.
# На VPS — `/opt/meeting-notary/_methods/` (туда launchd-агент на маке
# `com.ilarybalka.meeting-notary.methods-push` пушит файл раз в час
# из `~/Projects/me/methods/`). На маке fallback идёт прямо в
# `~/Projects/me/methods/`. Переопределить можно здесь, например на
# Docker volume или тестовый каталог.
MEETING_NOTARY_METHODS_DIR=/opt/meeting-notary/_methods

# Корень папки встреч. На маке дефолт `~/Projects/me/встречи`. На VPS
# Telegram-команда «протокол <series> <date>» в listener'е использует
# этот путь для поиска transcript-файла. Если структура иная — указать
# здесь, иначе можно не задавать.
# MEETING_NOTARY_PROTOCOLS_DIR=

# ---- Ф5 meeting-notary-llm: извлечение задач + маршрутизация ----

# Гейт извлечения задач из протокола через Claude Sonnet 4.6.
# Дефолт ON. Когда extract ON, а routing OFF — задачи извлекаются и
# логируются, но в tasks.md/треки не пишутся (полезно для дебага промта).
ENABLE_TASK_EXTRACTION=1

# Гейт маршрутизации извлечённых задач в файлы (`tasks.md`, треки
# стейкхолдеров, clarification). Дефолт ON.
ENABLE_TASK_ROUTING=1

# Путь к `tasks.md` Ильи. Дефолт `$ME_DIR/tasks.md` либо `~/Projects/me/tasks.md`.
# На VPS `~/Projects/me/` mirror'ится с мака — задачи дописываются туда же.
# MEETING_NOTARY_TASKS_MD=

# Путь к JSON-реестру стейкхолдеров (для Ф5). Дефолт:
#   - `/opt/meeting-notary/_methods/stakeholders.json` (на VPS, пушится с мака)
#   - `~/Projects/me/methods/stakeholders.json` (мак-fallback)
# Если ни один не найден — fallback на прямой импорт `~/Projects/me-dashboard/
# stakeholders.py` (только локально на маке).
# MEETING_NOTARY_STAKEHOLDERS_JSON=

# ---- Ф6 meeting-notary-llm: доставка протокола в группу + correction flow ----

# Гейт идемпотентной доставки протокола в Telegram-группу. Дефолт ON.
# Когда OFF: `deliver_protocol` логирует `disabled` и возвращает
# `{status: "disabled"}` — finalize не падает, протокол на диске есть,
# можно переотправить вручную позже включением гейта + повторной
# финализацией (idempotent skip защитит от дубля если уже доставлено).
ENABLE_PROTOCOL_DELIVERY=1

# ---- Ф7 meeting-notary-llm: миграция структуры + INDEX.md ----

# Гейт автогенерации `INDEX.md` в корне `~/Projects/me/встречи/` в конце
# финализации. Дефолт ON. На VPS (`MEETING_NOTARY_LOCAL_FINALIZE=1`) INDEX
# не пишется — данные уезжают на мак, индекс живёт только там.
# Без LLM, простой `os.walk` + sort (lib/vstrechi_index.py).
ENABLE_VSTRECHI_INDEX=1

# ---- Ф8 meeting-notary-llm: авто-пополнение Speechmatics vocab ----

# Выключатель LLM-proposer'а (кандидаты в vocab после встречи). Любое из
# 1/true/yes — proposer НЕ зовёт Claude вообще (сразу пустой результат).
# В тестах ставь 1 (иначе каждый тестовый finalize шлёт запрос Claude).
# В проде 0 — НО держи 1, пока не задеплоен applier (Шаг 8.3): без него
# кандидаты только логируются и складываются в stash, вызовы Claude впустую.
DISABLE_AUTO_VOCAB=1

# Timeout (сек) одного вызова Claude в LLM-proposer'е. Дефолт 120 (НЕ 30 из
# плана: `claude --print` CLI имеет cold-start; замер — 45с timeout, 120с успех).
# Proposer best-effort: при timeout — WARN + skip, следующая встреча повторит.
# PROPOSER_TIMEOUT_S=120

# Модель Claude для proposer'а (алиас CLI: sonnet/opus/haiku или полный id).
# Дефолт sonnet — дёшево и достаточно для извлечения терминов.
# PROPOSER_MODEL=sonnet

# Корень источников для слоя 1 (sources.py: people.md/companies/projects/ideas).
# На маке — ~/Projects/me. На VPS — путь к зеркалу ~/Projects/me (mirror'ится
# с мака; см. me-mirror выше). Если не задан — fallback на ~/Projects/me.
# MEETING_NOTARY_ME_DIR=/home/dev/Projects/me

# Путь к состоянию авто-пополнения (auto_vocab_state.json: rejected/
# approved_patterns/weekly_stats). Дефолт — рядом с vocab-конфигом
# (SPEECHMATICS_VOCAB_PATH), т.е. /srv/meeting-notary/config/.
# AUTO_VOCAB_STATE_PATH=
ENABLE_FEEDBACK_EDITS=0
ENABLE_FEEDBACK_LEARNING=0
ENABLE_FEEDBACK_ALLOWLIST=0
SPEECHMATICS_DIARIZATION_HINT=1
STT_WEEKLY_WARN_H=10
STT_WEEKLY_BLOCK_H=15
FEEDBACK_WINDOW_MIN=20
FEEDBACK_MAX_WINDOW_MIN=120
PROTOCOL_DELIVERY_GRACE_SEC=300

# Каталог состояния правок (feedback_state). ОБЯЗАТЕЛЕН на VPS: дефолт в коде —
# /opt/meeting-notary/_feedback_edits, а /opt принадлежит root → листенер под `dev`
# падает с PermissionError на write_state, и КАЖДАЯ правка (текст и голос, личка и
# группа) теряется без ack (инцидент 2026-06-08). Указывай dev-писабельный путь,
# тот же, под которым лежат транскрипты/delivered-roots.
# Пример (VPS): /home/dev/meeting-notary/_tmp/_feedback_edits
MEETING_NOTARY_FEEDBACK_DIR=/home/dev/meeting-notary/_tmp/_feedback_edits

# Корни, где reply-gate (feedback_worker._delivered_roots) ищет доставленные
# протоколы для матча реплая-правки. os.pathsep-разделённый список (на Linux `:`).
# ВАЖНО: env переопределяет дефолты ПОЛНОСТЬЮ (код НЕ добавляет дефолтные корни
# автоматически) — список должен быть исчерпывающим. Нужны ОБЕ ветки доставки:
#   - transcripts-meta (finalize/inline доставка, маркер delivered пишется сюда, Ф2);
#   - protocols-dir'ы (delivery_worker pending-доставка + дефолты TELEMOST/PROTOCOLS).
# Пример (VPS): /home/dev/meeting-notary/_tmp/transcripts:/opt/meeting-notary/_tmp/protocols:/home/dev/Projects/me/встречи:/home/dev/meeting-notary/_tmp/protocols
# MEETING_NOTARY_DELIVERED_ROOTS=
